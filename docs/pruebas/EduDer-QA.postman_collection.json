{
  "info": {
    "name": "EduDer-QA",
    "description": "Colección de pruebas del Bloque 2 y 3 de la Ficha de Plan y Registro de Ejecución de Pruebas. Ver docs/pruebas/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Preparación",
      "item": [
        {
          "name": "Registrar usuario de prueba (CP-01 / API-02)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/register",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_institucional\": \"{{correo}}\",\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Pérez\",\n  \"contrasena\": \"{{clave}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('correo')) pm.collectionVariables.set('correo', 'prueba.' + Date.now() + '@miremington.edu.co');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 201', () => pm.response.to.have.status(201));",
                  "pm.test('Tiempo <= 1000 ms (umbral RNF-02)', () => pm.expect(pm.response.responseTime).to.be.below(1001));",
                  "const j = pm.response.json();",
                  "pm.test('Devuelve token y usuario sin hash', () => { pm.expect(j.token).to.be.a('string'); pm.expect(j.usuario).to.not.have.property('contrasena_hash'); });",
                  "pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Casos funcionales (Bloque 2)",
      "item": [
        {
          "name": "CP-02 · Registro con dominio no institucional (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/register",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_institucional\": \"ana.qa@gmail.com\",\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Pérez\",\n  \"contrasena\": \"Clave1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 400', () => pm.response.to.have.status(400));",
                  "pm.test('Tiempo <= 1000 ms (umbral RNF-02)', () => pm.expect(pm.response.responseTime).to.be.below(1001));",
                  "pm.test('Mensaje de dominio institucional', () => pm.expect(pm.response.json().message).to.include('institucional'));"
                ]
              }
            }
          ]
        },
        {
          "name": "CP-03 · Bloqueo: intento fallido (repetir 5 veces → 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_institucional\": \"{{correo_bloqueo}}\",\n  \"contrasena\": \"IncorrectaSiempre1\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Credenciales incorrectas (401) o cuenta bloqueada (429)', () => pm.expect([401,429]).to.include(pm.response.code));",
                  "// Runner/Newman: repite esta petición hasta completar 5 intentos fallidos (RF-05)",
                  "const n = Number(pm.collectionVariables.get('intentos_fallidos') || 0) + 1; pm.collectionVariables.set('intentos_fallidos', n);",
                  "if (n < 5) { postman.setNextRequest(pm.info.requestName); } else { pm.collectionVariables.set('intentos_fallidos', 0); }"
                ]
              }
            }
          ]
        },
        {
          "name": "CP-03 · Bloqueo: sexto intento con contraseña correcta (429)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_institucional\": \"{{correo_bloqueo}}\",\n  \"contrasena\": \"{{clave}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 429', () => pm.response.to.have.status(429));",
                  "pm.test('Tiempo <= 1000 ms (umbral RNF-02)', () => pm.expect(pm.response.responseTime).to.be.below(1001));",
                  "pm.test('Mensaje de cuenta bloqueada', () => pm.expect(pm.response.json().message).to.include('bloqueada'));"
                ]
              }
            }
          ]
        },
        {
          "name": "CP-04 / API-05 · Evaluar ejercicio (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/exercise/answer",
              "host": [
                "{{base}}"
              ],
              "path": [
                "exercise",
                "answer"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_ejercicio\": \"{{id_ejercicio}}\",\n  \"respuesta\": \"{{respuesta_correcta}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tiempo <= 1000 ms (umbral RNF-02)', () => pm.expect(pm.response.responseTime).to.be.below(1001));",
                  "pm.test('correcto = true', () => pm.expect(pm.response.json().correcto).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "CP-05 · Completar lección, 1.ª vez (suma XP)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/progress/{{id_leccion}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "progress",
                "{{id_leccion}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"completada\",\n  \"puntaje\": 100\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tiempo <= 1000 ms (umbral RNF-02)', () => pm.expect(pm.response.responseTime).to.be.below(1001));",
                  "pm.test('Suma XP', () => pm.expect(pm.response.json().resumen.xp_ganado).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "CP-05 · Completar lección, 2.ª vez (no suma XP)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/progress/{{id_leccion}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "progress",
                "{{id_leccion}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"completada\",\n  \"puntaje\": 100\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tiempo <= 1000 ms (umbral RNF-02)', () => pm.expect(pm.response.responseTime).to.be.below(1001));",
                  "pm.test('No vuelve a sumar XP (RN-04)', () => pm.expect(pm.response.json().resumen.xp_ganado).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "CP-06 · Login válido y vigencia del JWT (200, 24 h)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_institucional\": \"{{correo}}\",\n  \"contrasena\": \"{{clave}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tiempo <= 1000 ms (umbral RNF-02)', () => pm.expect(pm.response.responseTime).to.be.below(1001));",
                  "const tk = pm.response.json().token; const p = JSON.parse(CryptoJS.enc.Base64.parse(tk.split('.')[1].replace(/-/g,'+').replace(/_/g,'/')).toString(CryptoJS.enc.Utf8));",
                  "pm.test('exp - iat = 86400 s (24 h, RF-03)', () => pm.expect(p.exp - p.iat).to.eql(86400));",
                  "pm.collectionVariables.set('token', tk);"
                ]
              }
            }
          ]
        }
      ]
    },
