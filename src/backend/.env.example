# =============================================
# EduDer Backend — Variables de Entorno
# Copiar como .env y completar valores reales
# =============================================

# Servidor
PORT=3000
NODE_ENV=development

# Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eduder
DB_USER=root
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=7d

# SMTP (correo recuperación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@uniremington.edu.co
SMTP_PASS=your_smtp_password

# FCM (Firebase Cloud Messaging)
FCM_SERVER_KEY=your_fcm_key_here
